{
  "manifest_version": 3,
  "name": "LeetCode Auth Info",
  "description": "Quickly view and copy your LeetCode authentication cookies.",
  "version": "1.0.0",

  "permissions": [
    "cookies",
    "tabs"
  ],

  "host_permissions": [
    "https://leetcode.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Auth Info"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}